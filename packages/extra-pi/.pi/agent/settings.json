{
  "logLevel": "warn",
  "extensions": [
    "extensions/model-aliases"
  ],
  "packages": [
    "npm:pi-lens",
    "npm:pi-mcp-adapter",
    "npm:pi-subagents",
    "npm:pi-emote",
    "npm:@gotgenes/pi-permission-system",
    "npm:pi-atelier",
    "npm:pi-total-recall"
  ],
  "subagents": {
    "agentOverrides": {
      "scout": {
        "model": "plan"
      },
      "researcher": {
        "model": "plan"
      },
      "planner": {
        "model": "plan"
      },
      "worker": {
        "model": "code"
      },
      "reviewer": {
        "model": "review"
      },
      "context-builder": {
        "model": "plan"
      },
      "oracle": {
        "model": "plan"
      },
      "delegate": {
        "model": "plan"
      }
    }
  },
  "lastChangelogVersion": "0.84.1",
  "defaultProvider": "omega",
  "defaultModel": "code",
  "defaultThinkingLevel": "high",
  "retry": {
    "enabled": true,
    "maxRetries": 3,
    "baseDelayMs": 2000,
    "provider": {
      "timeoutMs": 1800000
    }
  },
  "theme": "dark"
}
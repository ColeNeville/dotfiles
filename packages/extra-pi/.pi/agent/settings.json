{
  "logLevel": "warn",
  "extensions": [
    "extensions/model-aliases"
  ],
  "packages": [
    "npm:pi-lens",
    "npm:pi-permission-system",
    "npm:pi-mcp-adapter",
    {
      "source": "npm:@juicesharp/rpiv-ask-user-question",
      "extensions": [
        "+index.ts"
      ]
    },
    "npm:@juicesharp/rpiv-todo",
    "npm:pi-subagents",
    "npm:pi-emote",
    "npm:pi-total-recall"
  ],
  "subagents": {
    "agentOverrides": {
      "scout": {
        "model": "plan"
      },
      "researcher": {
        "model": "plan"
      },
      "planner": {
        "model": "plan"
      },
      "worker": {
        "model": "code"
      },
      "reviewer": {
        "model": "review"
      },
      "context-builder": {
        "model": "plan"
      },
      "oracle": {
        "model": "plan"
      },
      "delegate": {
        "model": "plan"
      }
    }
  },
  "lastChangelogVersion": "0.80.3",
  "defaultProvider": "omega",
  "defaultModel": "qwen3.6-35b-a3b",
  "defaultThinkingLevel": "medium",
  "retry": {
    "enabled": true,
    "maxRetries": 3,
    "baseDelayMs": 2000,
    "provider": {
      "timeoutMs": 1800000
    }
  },
  "theme": "dark"
}